{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "reviewers": ["team:security"],

  "minimumReleaseAge": "5 days",

  "customManagers": [
    {
      "customType": "regex",
      "description": "Track container image digests in Make file. Images are pulled through the ECR cache ($(ECR_MIRROR)), which Renovate cannot query, so look them up on public.ecr.aws",
      "fileMatch": ["^Make$", "Makefile"],
      "matchStrings": [
        "[A-Z_0-9-]+\\s*=\\s*\\$\\(ECR_MIRROR\\)/(?<depName>[^\\s:]+):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "public.ecr.aws/{{{depName}}}",
      "datasourceTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "Do not bump to a new major JDK version automatically",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group all Makefile Docker digest updates into a single PR to avoid merge conflicts",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["^Make$", "Makefile"],
      "groupName": "Makefile Docker digests"
    }
  ]
}
